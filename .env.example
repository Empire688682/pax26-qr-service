# Server
PORT=3001

# MongoDB (same DB as your Next.js app)
MONGODB_URI=mongodb+srv://...

# URL of your deployed Next.js app (for sending webhooks back)
# Local: http://localhost:3000
# Production: https://pax26.com
NEXT_APP_URL=http://localhost:3000

# Shared secret between Next.js app and this QR service
# Must match QR_SERVICE_SECRET in your Next.js .env
QR_SERVICE_SECRET=your-service-secret

# Cloudinary (for storing customer images sent via WhatsApp)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
